# PackScan — copy this file to `.env` in the same folder (packscan/.env)
# Then adjust values if needed. Do NOT commit real secrets (none required for local demo).

# ---------- Backend API ----------
PACKSCAN_API_HOST=127.0.0.1
PACKSCAN_API_PORT=8000

# OCR engine: paddle | tesseract | auto
PACKSCAN_OCR_ENGINE=paddle

# SQLite database file name (created inside backend/)
PACKSCAN_DB_NAME=packscan_v2.db

# CORS (use * for local demo)
PACKSCAN_CORS_ORIGINS=*

# ---------- Frontend (Vite proxy target) ----------
# Must match backend host:port above
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173
